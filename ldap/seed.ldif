# Directory skeleton. Unlike Warden there is no privileged subtree here: users log in with
# their own credential end to end, so one identity subtree is all this demo needs.
dn: ${MFA_USER_SEARCH_BASE}
objectClass: organizationalUnit
ou: people

dn: ou=groups,${BASE_DN}
objectClass: organizationalUnit
ou: groups

dn: ou=svc,${BASE_DN}
objectClass: organizationalUnit
ou: svc

dn: ${MFA_BIND_DN}
objectClass: inetOrgPerson
cn: bigip-bind
sn: service
userPassword: ${MFA_BIND_PW}
