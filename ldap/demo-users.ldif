# The two demo principals. They differ in exactly one way — membership in the admin group —
# and that single difference is what the demo makes visible: alice lands in TMUI as
# Administrator, bob lands in the same TMUI as read-only. Neither APM nor Keycloak decides
# that; the target BIG-IP's remote-role does, from memberOf.
#
# Applied AFTER ldap/memberof-overlay.ldif, or memberOf is never populated and everyone
# falls through to the read-only default role.
dn: uid=alice.admin,${WL_USER_SEARCH_BASE}
objectClass: inetOrgPerson
uid: alice.admin
cn: Alice Admin
sn: Admin
mail: alice.admin@${WL_DOMAIN}
userPassword: ${WL_TEST_USER_PW}

dn: uid=bob.user,${WL_USER_SEARCH_BASE}
objectClass: inetOrgPerson
uid: bob.user
cn: Bob User
sn: User
mail: bob.user@${WL_DOMAIN}
userPassword: ${WL_TEST_USER_PW}

# groupOfNames requires at least one member at creation, so alice is seeded inline.
dn: ${WL_ADMIN_GROUP_DN}
objectClass: groupOfNames
cn: bigip-admins
member: uid=alice.admin,${WL_USER_SEARCH_BASE}
