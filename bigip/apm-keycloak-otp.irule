# APM iRule Event handler that verifies the logon page's three fields against Keycloak.
#
# The per-session policy fires an 'iRule Event' agent with id `kc_verify`; this posts
# username + password + otp to Keycloak's token endpoint as a direct grant and sets
# session.custom.kc.verified to 1 only if Keycloak returns an access token. Keycloak
# validates BOTH factors against ONE identity in that single call, so a valid password
# paired with somebody else's authenticator comes back 401 -- the binding is enforced by
# the identity provider, not by a comparison here that could be forgotten.
#
# The sideband target is a local, non-routable facade virtual server (${SHADOW_KC}); that
# virtual re-encrypts to Keycloak with a server-side profile. The cleartext hop therefore
# never leaves TMM, while the hop that crosses the network is TLS.
#
# Why an iRule and not the built-in HTTP AAA agent: `apm aaa http` refuses an https://
# backend outright, and against the layered facade it produced no result and no
# session.http.* variables at all. The sideband gives the same call with visible failure
# modes.
#
# PoC-grade: regex response matching rather than a JSON parser. For production use
# iRulesLX, and source the client secret from a data group rather than rendering it in.
#-----------------------------------------------------------------------------
when ACCESS_POLICY_AGENT_EVENT {
    if { [ACCESS::policy agent_id] eq "kc_verify" } {
        ACCESS::session data set session.custom.kc.verified 0

        set u [ACCESS::session data get session.logon.last.username]
        set p [ACCESS::session data get session.logon.last.password]
        set o [ACCESS::session data get session.logon.last.otp]
        # Separate tests rather than one compound condition: the TMOS iRule compiler
        # rejects some `||` expressions that plain Tcl accepts.
        if { $u equals "" } { return }
        if { $p equals "" } { return }
        if { $o equals "" } { return }

        # URI-encode the values that may contain reserved characters.
        set body "grant_type=password"
        append body "&client_id=${MFA_OIDC_CLIENT_ID}"
        append body "&client_secret=${MFA_OIDC_CLIENT_SECRET}"
        append body "&scope=openid"
        append body "&username=[URI::encode $u]"
        append body "&password=[URI::encode $p]"
        append body "&otp=[URI::encode $o]"

        set c [connect -timeout 5000 -idle 10 ${SHADOW_KC}:80]
        log local0. "wl-kc: connect to ${SHADOW_KC}:80 returned '$c'"
        if { $c eq "" } {
            ACCESS::session data set session.custom.kc.err "connect-failed"
            return
        }
        set req "POST /realms/${MFA_KEYCLOAK_REALM}/protocol/openid-connect/token HTTP/1.1\r\n"
        append req "Host: ${MFA_KEYCLOAK_FQDN}:${MFA_KEYCLOAK_PORT}\r\n"
        append req "Content-Type: application/x-www-form-urlencoded\r\n"
        append req "Content-Length: [string length $body]\r\n"
        append req "Connection: close\r\n\r\n"
        append req $body
        send -timeout 5000 $c $req

        set resp ""
        for { set i 0 } { $i < 32 } { incr i } {
            set chunk [recv -timeout 2000 $c]
            if { $chunk eq "" } { break }
            append resp $chunk
        }
        close $c
        log local0. "wl-kc: response bytes=[string length $resp] first120=[string range $resp 0 120]"

        # A token in the body is the only thing that counts as success. Anything else --
        # 401 invalid_user_credentials, a lockout, an unreachable Keycloak -- leaves the
        # variable at 0 and the policy branches to Deny.
        if { [string first "access_token" $resp] >= 0 } {
            ACCESS::session data set session.custom.kc.verified 1
        } else {
            ACCESS::session data set session.custom.kc.err "no-token"
        }
    }
}
