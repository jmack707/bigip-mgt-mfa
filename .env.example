# bigip-mgt-mfa demo configuration. Copy to .env (gitignored) and fill in the
# <angle-bracket> values. The REQUIRED blocks are all you must set; everything else has a
# working default. Full reference: docs/reference/configuration.md.

# ─── REQUIRED: this host ────────────────────────────────────────────────────
# IP of the Docker host running Keycloak + OpenLDAP, as the BIG-IP reaches it.
# The generated LDAPS and Keycloak server-cert SANs are built from this, so it must match.
MFA_HOST_IP=<this-host-ip>

# ─── REQUIRED: directory ────────────────────────────────────────────────────
# bundled  = bigip-mgt-mfa runs its own OpenLDAP in Docker and seeds it (default; zero setup).
# external = bring your own AD / FreeIPA / LDAP. bigip-mgt-mfa creates NOTHING in it and
#            Keycloak federates it read-only — see docs/directory.md.
MFA_DIRECTORY_MODE=bundled
MFA_DOMAIN=bigip-mgt-mfa.lab           # LDAP domain (bundled: drives the container + cert SAN)
BASE_DN=dc=bigip-mgt-mfa,dc=lab       # must correspond to MFA_DOMAIN
MFA_LDAP_ADMIN_PW=<change-me>        # bundled only: OpenLDAP cn=admin password
MFA_BIND_PW=<change-me>              # read-only bind password APM and the BIG-IP search with

# ─── the BIG-IP admin group ─────────────────────────────────────────────────
# Members of this group get Administrator on both BIG-IPs; every other identity that
# authenticates lands on the default role (guest = read-only). Authorization is decided by
# the target BIG-IP's remote-role, not by APM — see docs/adr/0003-authorization-on-remote-role.md.
MFA_ADMIN_GROUP_DN=                  # default: cn=bigip-admins,ou=groups,${BASE_DN}
# How the BIG-IP decides admin-ness, as <attribute>=<value>.
# Default: memberOf=${MFA_ADMIN_GROUP_DN} (real group membership, both bundled and external).
MFA_ADMIN_ROLE_ATTRIBUTE=

# ─── directory connection ───────────────────────────────────────────────────
# Only MFA_LDAP_HOST, MFA_LDAP_SCHEMA and MFA_LDAP_CA_FILE are external-mode-only. The ports and
# the three derived values below are live in BOTH modes — APM builds its AAA pool on
# MFA_LDAP_PORT and the BIG-IP system auth uses MFA_LDAPS_PORT even against the bundled
# directory. Validate all of this before touching a BIG-IP: scripts/preflight-directory.sh
MFA_LDAP_HOST=                       # external only: AD DC / LDAP address (bundled: MFA_HOST_IP)
MFA_LDAP_SCHEMA=openldap             # external only: openldap | ad (ad logs in as sAMAccountName)
MFA_LDAP_CA_FILE=                    # external only: PEM of the CA that issued your LDAPS cert
MFA_LDAP_PORT=389                    # plain LDAP (APM AAA bind + Keycloak federation)
MFA_LDAPS_PORT=636                   # LDAPS (BIG-IP system-auth)
MFA_BIND_DN=                         # read-only search bind (default cn=bigip-bind,ou=svc,${BASE_DN})
MFA_USER_SEARCH_BASE=                # identity subtree (default ou=people,${BASE_DN})
MFA_LOGIN_ATTR=                      # default uid, or sAMAccountName when schema=ad

# ─── DNS ────────────────────────────────────────────────────────────────────
# bigip-mgt-mfa ships its own resolver (CoreDNS) authoritative for MFA_DOMAIN, because the
# BIG-IP's OAuth client resolves through a TMOS dns-resolver that cannot read a hosts file.
# The BIG-IP is pointed here; everything else is forwarded upstream.
MFA_DNS_PORT=53                      # host port CoreDNS binds (change if :53 is taken)
MFA_DNS_UPSTREAM=1.1.1.1             # where non-demo names are forwarded

# ─── REQUIRED: Keycloak (second factor) ─────────────────────────────────────
# APM redirects to Keycloak for OIDC step-up after it has authenticated the password.
# The FQDN must resolve identically for the browser AND the BIG-IP, or the redirect breaks.

# ─── REQUIRED: the BIG-IP HA pair ───────────────────────────────────────────
BIGIP_USER=admin
BIGIP_PASS=<bigip-admin-pw>         # demo: plaintext here. PRODUCTION: use a secret manager,
                                    # not .env. Wrappers preserve an injected value if set.
BIGIP_A_MGMT=<bigip-a-mgmt-ip>      # unit A management address (REST) — APM is built here
BIGIP_B_MGMT=<bigip-b-mgmt-ip>      # unit B management address (REST) — remote-role only
BIGIP_A_TMUI=<bigip-a-internal-selfip>  # A's non-floating internal self IP (SSO target)
BIGIP_B_TMUI=<bigip-b-internal-selfip>  # B's non-floating internal self IP (SSO target)

# ─── APM data-plane ─────────────────────────────────────────────────────────
MFA_APM_VIP=<apm-vip-ip>             # the webtop VIP customers browse to (https://<vip>/)
MFA_WEBTOP_FQDN=webtop.bigip-mgt-mfa.lab   # name on the VIP cert; the OIDC redirect_uri origin
MFA_APM_TRAFFIC_GROUP=traffic-group-1    # float the VIP so the webtop survives a failover
MFA_SHADOW_A=192.0.2.5               # RFC5737 TEST-NET façade for A's TMUI (non-routable)
MFA_SHADOW_B=192.0.2.6               # façade for B's TMUI

# ─── demo principals ────────────────────────────────────────────────────────
MFA_TEST_USER_PW=<change-me>         # bundled only: password for the demo users (alice/bob)

# ─── HA ─────────────────────────────────────────────────────────────────────
# Device group used for config-sync. Empty = discover the sync-failover group via REST.
MFA_DEVICE_GROUP=

# ─── rarely changed, but real ───────────────────────────────────────────────
# These all have working defaults and are listed so they are discoverable without reading
# the scripts. MFA_REGEN_CA in particular is an operator action, not a setting: exporting it
# for one run rolls the CA, which invalidates every browser trust import and requires
# ./deploy.sh --bigip afterwards to reinstall the anchor on both units.
#   MFA_REGEN_CA=1                   one-shot: mint a NEW CA instead of reusing certs/ca.crt
MFA_CA_CN=bigip-mgt-mfa Demo CA        # subject CN of the generated CA
MFA_ORG=bigip-mgt-mfa                  # bundled only: OpenLDAP organisation name
MFA_LDAP_CA_NAME=                    # name of the CA object created on the BIG-IP
# Keycloak LDAP federation. Derived from MFA_LDAP_SCHEMA; override only for a directory that
# matches neither profile. Getting the vendor or UUID attribute wrong imports zero users
# with no useful error.
MFA_KC_LDAP_HOST=                    # default: openldap (bundled) or MFA_LDAP_HOST (external)
MFA_KC_LDAP_VENDOR=                  # default: other, or ad when MFA_LDAP_SCHEMA=ad
MFA_KC_LDAP_UUID_ATTR=               # default: entryUUID, or objectGUID for ad
MFA_KC_LDAP_USER_CLASSES=            # default: inetOrgPerson, organizationalPerson

MFA_SHADOW_KC=192.0.2.7              # RFC5737 façade for the layered Keycloak call

# TOTP step in seconds. 30 is the universal default; 60 is gentler to type but NOTE that
# Google Authenticator ignores anything other than 30 and will silently produce wrong codes.
# FreeOTP, Aegis and 1Password honour it.
MFA_TOTP_PERIOD=60

# Steps of tolerance either side of the current one. They MULTIPLY with the period: the
# window a code is accepted in is period * (2*skew + 1). 60s with skew 1 = three minutes.
# Set 0 for the tightest window (needs accurate NTP on the units); 1 is forgiving for demos.
MFA_TOTP_SKEW=1
