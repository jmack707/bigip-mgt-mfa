# warden-lite demo configuration. Copy to .env (gitignored) and fill in the
# <angle-bracket> values. The REQUIRED blocks are all you must set; everything else has a
# working default. Full reference: docs/reference/configuration.md.

# ─── REQUIRED: this host ────────────────────────────────────────────────────
# IP of the Docker host running Keycloak + OpenLDAP, as the BIG-IP reaches it.
# The generated LDAPS and Keycloak server-cert SANs are built from this, so it must match.
WL_HOST_IP=<this-host-ip>

# ─── REQUIRED: directory ────────────────────────────────────────────────────
# bundled  = warden-lite runs its own OpenLDAP in Docker and seeds it (default; zero setup).
# external = bring your own AD / FreeIPA / LDAP. warden-lite creates NOTHING in it and
#            Keycloak federates it read-only — see docs/directory.md.
WL_DIRECTORY_MODE=bundled
WL_DOMAIN=warden-lite.lab           # LDAP domain (bundled: drives the container + cert SAN)
BASE_DN=dc=warden-lite,dc=lab       # must correspond to WL_DOMAIN
WL_LDAP_ADMIN_PW=<change-me>        # bundled only: OpenLDAP cn=admin password
WL_BIND_PW=<change-me>              # read-only bind password APM and the BIG-IP search with

# ─── the BIG-IP admin group ─────────────────────────────────────────────────
# Members of this group get Administrator on both BIG-IPs; every other identity that
# authenticates lands on the default role (guest = read-only). Authorization is decided by
# the target BIG-IP's remote-role, not by APM — see docs/adr/0003-authorization-on-remote-role.md.
WL_ADMIN_GROUP_DN=                  # default: cn=bigip-admins,ou=groups,${BASE_DN}
# How the BIG-IP decides admin-ness, as <attribute>=<value>.
# Default: memberOf=${WL_ADMIN_GROUP_DN} (real group membership, both bundled and external).
WL_ADMIN_ROLE_ATTRIBUTE=

# ─── directory connection ───────────────────────────────────────────────────
# Only WL_LDAP_HOST, WL_LDAP_SCHEMA and WL_LDAP_CA_FILE are external-mode-only. The ports and
# the three derived values below are live in BOTH modes — APM builds its AAA pool on
# WL_LDAP_PORT and the BIG-IP system auth uses WL_LDAPS_PORT even against the bundled
# directory. Validate all of this before touching a BIG-IP: scripts/preflight-directory.sh
WL_LDAP_HOST=                       # external only: AD DC / LDAP address (bundled: WL_HOST_IP)
WL_LDAP_SCHEMA=openldap             # external only: openldap | ad (ad logs in as sAMAccountName)
WL_LDAP_CA_FILE=                    # external only: PEM of the CA that issued your LDAPS cert
WL_LDAP_PORT=389                    # plain LDAP (APM AAA bind + Keycloak federation)
WL_LDAPS_PORT=636                   # LDAPS (BIG-IP system-auth)
WL_BIND_DN=                         # read-only search bind (default cn=bigip-bind,ou=svc,${BASE_DN})
WL_USER_SEARCH_BASE=                # identity subtree (default ou=people,${BASE_DN})
WL_LOGIN_ATTR=                      # default uid, or sAMAccountName when schema=ad

# ─── DNS ────────────────────────────────────────────────────────────────────
# warden-lite ships its own resolver (CoreDNS) authoritative for WL_DOMAIN, because the
# BIG-IP's OAuth client resolves through a TMOS dns-resolver that cannot read a hosts file.
# The BIG-IP is pointed here; everything else is forwarded upstream.
WL_DNS_PORT=53                      # host port CoreDNS binds (change if :53 is taken)
WL_DNS_UPSTREAM=1.1.1.1             # where non-demo names are forwarded

# ─── REQUIRED: Keycloak (second factor) ─────────────────────────────────────
# APM redirects to Keycloak for OIDC step-up after it has authenticated the password.
# The FQDN must resolve identically for the browser AND the BIG-IP, or the redirect breaks.
WL_KEYCLOAK_FQDN=keycloak.warden-lite.lab
WL_KEYCLOAK_PORT=8443
WL_KEYCLOAK_REALM=warden-lite
WL_KEYCLOAK_ADMIN=admin
WL_KEYCLOAK_ADMIN_PW=<change-me>    # Keycloak master-realm admin console password
WL_OIDC_CLIENT_ID=bigip-apm
WL_OIDC_CLIENT_SECRET=<change-me>   # shared between the Keycloak client and the APM OAuth server

# ─── REQUIRED: the BIG-IP HA pair ───────────────────────────────────────────
BIGIP_USER=admin
BIGIP_PASS=<bigip-admin-pw>         # demo: plaintext here. PRODUCTION: use a secret manager,
                                    # not .env. Wrappers preserve an injected value if set.
BIGIP_A_MGMT=<bigip-a-mgmt-ip>      # unit A management address (REST) — APM is built here
BIGIP_B_MGMT=<bigip-b-mgmt-ip>      # unit B management address (REST) — remote-role only
BIGIP_A_TMUI=<bigip-a-internal-selfip>  # A's non-floating internal self IP (SSO target)
BIGIP_B_TMUI=<bigip-b-internal-selfip>  # B's non-floating internal self IP (SSO target)

# ─── APM data-plane ─────────────────────────────────────────────────────────
WL_APM_VIP=<apm-vip-ip>             # the webtop VIP customers browse to (https://<vip>/)
WL_WEBTOP_FQDN=webtop.warden-lite.lab   # name on the VIP cert; the OIDC redirect_uri origin
WL_APM_TRAFFIC_GROUP=traffic-group-1    # float the VIP so the webtop survives a failover
WL_SHADOW_A=192.0.2.5               # RFC5737 TEST-NET façade for A's TMUI (non-routable)
WL_SHADOW_B=192.0.2.6               # façade for B's TMUI

# ─── demo principals ────────────────────────────────────────────────────────
WL_TEST_USER_PW=<change-me>         # bundled only: password for the demo users (alice/bob)

# ─── HA ─────────────────────────────────────────────────────────────────────
# Device group used for config-sync. Empty = discover the sync-failover group via REST.
WL_DEVICE_GROUP=

# ─── rarely changed, but real ───────────────────────────────────────────────
# These all have working defaults and are listed so they are discoverable without reading
# the scripts. WL_REGEN_CA in particular is an operator action, not a setting: exporting it
# for one run rolls the CA, which invalidates every browser trust import and requires
# ./deploy.sh --bigip afterwards to reinstall the anchor on both units.
#   WL_REGEN_CA=1                   one-shot: mint a NEW CA instead of reusing certs/ca.crt
WL_CA_CN=warden-lite Demo CA        # subject CN of the generated CA
WL_ORG=warden-lite                  # bundled only: OpenLDAP organisation name
WL_LDAP_CA_NAME=                    # name of the CA object created on the BIG-IP
# Keycloak LDAP federation. Derived from WL_LDAP_SCHEMA; override only for a directory that
# matches neither profile. Getting the vendor or UUID attribute wrong imports zero users
# with no useful error.
WL_KC_LDAP_HOST=                    # default: openldap (bundled) or WL_LDAP_HOST (external)
WL_KC_LDAP_VENDOR=                  # default: other, or ad when WL_LDAP_SCHEMA=ad
WL_KC_LDAP_UUID_ATTR=               # default: entryUUID, or objectGUID for ad
WL_KC_LDAP_USER_CLASSES=            # default: inetOrgPerson, organizationalPerson

WL_SHADOW_KC=192.0.2.7              # RFC5737 façade for the layered Keycloak call
