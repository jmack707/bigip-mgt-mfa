{
  "_comment": "Rendered by deploy.sh (envsubst) to keycloak/import/ and imported at container start. Do not edit the rendered copy — it is gitignored and overwritten on every deploy.",
  "realm": "${WL_KEYCLOAK_REALM}",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 10,

  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyInitialCounter": 0,
  "otpSupportedApplications": ["totpAppFreeOTPName", "totpAppGoogleName", "totpAppMicrosoftAuthenticatorName"],

  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    }
  ],

  "_comment_flow": "Second-factor-ONLY browser flow. APM has already proven the password against the directory before it redirects here, so asking for it again would be a second password prompt for no added assurance. Username Form re-establishes which identity is being stepped up; OTP Form is the actual factor. auth-cookie is deliberately absent so every redirect re-runs OTP and the demo is deterministic. SECURITY: this realm is a second-factor oracle, not a standalone IdP — do not point another application at it. See docs/adr/0002-second-factor-only-realm.md.",
  "authenticationFlows": [
    {
      "alias": "warden-lite second factor",
      "description": "Username Form then OTP Form. No password — APM already checked it.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "browserFlow": "warden-lite second factor",

  "clients": [
    {
      "clientId": "${WL_OIDC_CLIENT_ID}",
      "name": "BIG-IP APM webtop",
      "description": "The APM access profile, acting as an OIDC relying party for step-up MFA.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "secret": "${WL_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://${WL_WEBTOP_FQDN}/oauth/client/redirect",
        "https://${WL_APM_VIP}/oauth/client/redirect"
      ],
      "webOrigins": [
        "https://${WL_WEBTOP_FQDN}",
        "https://${WL_APM_VIP}"
      ],
      "attributes": {
        "post.logout.redirect.uri": "+"
      },
      "protocolMappers": [
        {
          "name": "username-as-sub-and-preferred-username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],

  "_comment_ldap": "Read-only federation of the SAME directory APM authenticates against, so the OTP is bound to the same identity and Keycloak never becomes a second password store. editMode READ_ONLY is load-bearing: Keycloak must not be able to write to a customer's AD.",
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "warden-lite-directory",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["${WL_LOGIN_ATTR}"],
                "user.model.attribute": ["username"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["false"],
                "is.mandatory.in.ldap": ["true"]
              }
            },
            {
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["mail"],
                "user.model.attribute": ["email"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["false"],
                "is.mandatory.in.ldap": ["false"]
              }
            },
            {
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["cn"],
                "user.model.attribute": ["firstName"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "is.mandatory.in.ldap": ["true"]
              }
            },
            {
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["sn"],
                "user.model.attribute": ["lastName"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "is.mandatory.in.ldap": ["true"]
              }
            }
          ]
        },
        "config": {
          "enabled": ["true"],
          "vendor": ["${WL_KC_LDAP_VENDOR}"],
          "connectionUrl": ["ldap://${WL_KC_LDAP_HOST}:${WL_LDAP_PORT}"],
          "usersDn": ["${WL_USER_SEARCH_BASE}"],
          "bindDn": ["${WL_BIND_DN}"],
          "bindCredential": ["${WL_BIND_PW}"],
          "authType": ["simple"],
          "editMode": ["READ_ONLY"],
          "importEnabled": ["true"],
          "syncRegistrations": ["false"],
          "usernameLDAPAttribute": ["${WL_LOGIN_ATTR}"],
          "rdnLDAPAttribute": ["${WL_LOGIN_ATTR}"],
          "uuidLDAPAttribute": ["${WL_KC_LDAP_UUID_ATTR}"],
          "userObjectClasses": ["${WL_KC_LDAP_USER_CLASSES}"],
          "searchScope": ["2"],
          "pagination": ["true"],
          "trustEmail": ["false"],
          "useTruststoreSpi": ["always"],
          "connectionPooling": ["true"]
        }
      }
    ]
  }
}
