{
  "_comment": "Rendered by deploy.sh (envsubst, then jq strips every _comment key) to keycloak/import/ and imported at container start. Do not edit the rendered copy — it is gitignored and overwritten on every deploy.",
  "realm": "${WL_KEYCLOAK_REALM}",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 10,

  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyInitialCounter": 0,
  "otpSupportedApplications": ["totpAppFreeOTPName", "totpAppGoogleName", "totpAppMicrosoftAuthenticatorName"],

  "_comment_enrolment": "CONFIGURE_TOTP stays a default required action so a user must enrol an authenticator the first time they sign in to Keycloak's own Account Console. That console is where enrolment happens — the BIG-IP never enrols anyone, it only verifies. A user who has not enrolled cannot satisfy the direct-grant flow below and therefore cannot log in at the appliance, which is the correct order of operations.",
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    }
  ],

  "_comment_browser_flow": "The browser flow is left as Keycloak's stock 'browser' flow — username and password, then conditional OTP. This realm is an ordinary identity provider that a customer would recognise, used here for self-service MFA enrolment at the Account Console. An earlier revision replaced it with a password-less username+OTP flow so APM could step up to it; that made the realm unusable for anything else and, worse, left the second factor unbound from the first. See docs/adr/0002-single-logon-page-direct-grant.md.",
  "browserFlow": "browser",

  "_comment_direct_grant": "This is how the BIG-IP verifies a login. APM posts username + password + otp to the token endpoint in ONE call, and Keycloak validates all three against the same identity atomically — so a valid password paired with somebody else's authenticator is rejected. OTP is REQUIRED, not CONDITIONAL: the stock direct-grant flow only demands an OTP from users who happen to have one configured, which would let an un-enrolled account through on a password alone.",
  "authenticationFlows": [
    {
      "alias": "warden-lite direct grant",
      "description": "username + password + OTP validated together, for the BIG-IP APM logon page",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "direct-grant-validate-username",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "direct-grant-validate-password",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "direct-grant-validate-otp",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 30,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "directGrantFlow": "warden-lite direct grant",

  "clients": [
    {
      "clientId": "${WL_OIDC_CLIENT_ID}",
      "name": "BIG-IP APM logon page",
      "description": "Confidential client the BIG-IP uses to verify username+password+OTP in a single direct-grant call. No browser redirect is involved.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "secret": "${WL_OIDC_CLIENT_SECRET}",
      "_comment_flags": "standardFlow is OFF: APM is no longer an OIDC relying party and never redirects a browser here, so an authorization-code flow would be unused attack surface. directAccessGrants is the only flow this client needs.",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "access.token.lifespan": "60"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],

  "_comment_ldap": "Read-only federation of the SAME directory the BIG-IP authenticates against, so the OTP is bound to the same identity and Keycloak never becomes a second password store. editMode READ_ONLY is load-bearing: Keycloak must not be able to write to a customer's AD.",
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "warden-lite-directory",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["${WL_LOGIN_ATTR}"],
                "user.model.attribute": ["username"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["false"],
                "is.mandatory.in.ldap": ["true"]
              }
            },
            {
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["mail"],
                "user.model.attribute": ["email"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["false"],
                "is.mandatory.in.ldap": ["false"]
              }
            },
            {
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["cn"],
                "user.model.attribute": ["firstName"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "is.mandatory.in.ldap": ["true"]
              }
            },
            {
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["sn"],
                "user.model.attribute": ["lastName"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "is.mandatory.in.ldap": ["true"]
              }
            }
          ]
        },
        "config": {
          "enabled": ["true"],
          "vendor": ["${WL_KC_LDAP_VENDOR}"],
          "connectionUrl": ["ldap://${WL_KC_LDAP_HOST}:${WL_LDAP_PORT}"],
          "usersDn": ["${WL_USER_SEARCH_BASE}"],
          "bindDn": ["${WL_BIND_DN}"],
          "bindCredential": ["${WL_BIND_PW}"],
          "authType": ["simple"],
          "editMode": ["READ_ONLY"],
          "importEnabled": ["true"],
          "syncRegistrations": ["false"],
          "usernameLDAPAttribute": ["${WL_LOGIN_ATTR}"],
          "rdnLDAPAttribute": ["${WL_LOGIN_ATTR}"],
          "uuidLDAPAttribute": ["${WL_KC_LDAP_UUID_ATTR}"],
          "userObjectClasses": ["${WL_KC_LDAP_USER_CLASSES}"],
          "searchScope": ["2"],
          "pagination": ["true"],
          "trustEmail": ["false"],
          "useTruststoreSpi": ["always"],
          "connectionPooling": ["true"]
        }
      }
    ]
  }
}
